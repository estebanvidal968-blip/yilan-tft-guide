# ===== AI 文案生成（阵容中文点评 / 符文指引 / 选子技巧）=====
# 鉴权优先级：① OpenAI 兼容(LLM_*) 优先，② 腾讯混元 TC3 直连兜底。
# 任意 OpenAI 兼容厂商只改下面三个变量即可，代码零改。

# ① OpenAI 兼容（provider 无关，sk- 开头的 API Key）
#   当前默认指向智谱 GLM（已在用）。换厂商示例：
#     智谱 GLM   : LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4          LLM_MODEL=glm-4-flash
#     腾讯混元   : LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1     LLM_MODEL=hy4-preview
#     DeepSeek   : LLM_BASE_URL=https://api.deepseek.com/v1                   LLM_MODEL=deepseek-chat
#     Kimi       : LLM_BASE_URL=https://api.moonshot.cn/v1                    LLM_MODEL=moonshot-v1-8k
#     通义 Qwen  : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=sk-Mzk1LTIxNDU3MzU0MDAzLTE3ODgwODUzNzI5Mzc=
# 接口地址（默认智谱 GLM OpenAI 兼容端点）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型（默认 glm-4-flash 免费档；可选 glm-4-plus 最强 / glm-4-air 均衡）
LLM_MODEL=glm-4-flash

# ② 腾讯云 TC3-HMAC-SHA256 直连（原生 SDK 方式，SecretId / SecretKey，仅腾讯混元）
# 获取：https://console.cloud.tencent.com/hunyuan -> 新建密钥得到 SecretId / SecretKey
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
# 模型（默认 hunyuan-pro；可选 hunyuan-standard, hunyuan-lite 等）
HUNYUAN_MODEL=hunyuan-pro

# 数据存储目录（SQLite 库 / 原子文件存储落盘处）。
# 留空默认 <项目>/data；Docker / 常驻服务器请把挂载卷指向此目录以保证跨重启持久。
# 例如挂载卷：docker run -v yilan-data:/app/data ...  →  DATA_DIR=/app/data
DATA_DIR=data
