# ===== 腾讯混元（阵容中文评语生成）=====
# 两套鉴权二选一即可，OpenAI 兼容优先：

# ① OpenAI 兼容（推荐，sk- 开头的 API Key）
# 腾讯混元 hy4-preview 在 TokenHub：https://console.cloud.tencent.com/hunyuan -> TokenHub -> API Key 管理
# 如用官方 OpenAI 兼容端点（hunyuan-pro/turbo 等），base_url 可改成 https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_OPENAI_API_KEY=
# 接口地址（默认 TokenHub，hy4-preview 所在端点）
HUNYUAN_OPENAI_BASE_URL=https://tokenhub.tencentcloudmaas.com/v1
# 模型（默认 hy4-preview；可选 hunyuan-pro, hunyuan-turbo, hunyuan-lite, hunyuan-t1 等）
HUNYUAN_OPENAI_MODEL=hy4-preview

# ② 腾讯云 TC3-HMAC-SHA256 直连（原生 SDK 方式，SecretId / SecretKey）
# 获取：https://console.cloud.tencent.com/hunyuan -> 新建密钥得到 SecretId / SecretKey
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
# 模型（默认 hunyuan-pro；可选 hunyuan-standard, hunyuan-lite 等）
HUNYUAN_MODEL=hunyuan-pro

# 数据存储目录（SQLite 库 / 原子文件存储落盘处）。
# 留空默认 <项目>/data；Docker / 常驻服务器请把挂载卷指向此目录以保证跨重启持久。
# 例如挂载卷：docker run -v yilan-data:/app/data ...  →  DATA_DIR=/app/data
DATA_DIR=data
