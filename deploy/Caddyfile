# 弈览 · Caddy 反向代理配置（备案通过后 · 生产版）
# ============================================================
# - :80 段：IP 直访兜底 + 承载 Let's Encrypt HTTP-01 验证
# - 域名段：yilangames.com / www 自动 HTTPS（ACME 证书自动签发与续期）
# 容器 yilan 已改为 -p 127.0.0.1:3000:3000，由 Caddy 接管 80/443
# ============================================================

{
	email admin@yilangames.com
}

# IP 直访兜底（备案过渡 / 健康检查 / ACME 验证）
:80 {
	reverse_proxy 127.0.0.1:3000
	encode gzip
}

# 正式域名 + 自动 HTTPS
yilangames.com, www.yilangames.com {
	reverse_proxy 127.0.0.1:3000
	encode gzip
}

# 未来其他游戏子站示例（解析加 A 记录后取消注释即可）：
# lol.yilangames.com {
# 	reverse_proxy 127.0.0.1:3001
# }
