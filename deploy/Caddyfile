# 弈览 · Caddy 反向代理配置
# ============================================================
# 阶段一（备案前，当前）：用 IP 直接访问，不开 HTTPS
#   —— 把下面这一段留着，域名段全部注释
# ============================================================
:80 {
	reverse_proxy 127.0.0.1:3000
	encode gzip
}

# ============================================================
# 阶段二（ICP 备案通过后）：启用域名 + 自动 HTTPS
#   —— 删掉上面的 :80 段，取消下面注释，然后执行：
#   systemctl reload caddy
#   Caddy 会自动向 Let's Encrypt 申请证书并续期，零手工操作
# ============================================================
# yilangames.com, www.yilangames.com {
# 	reverse_proxy 127.0.0.1:3000
# 	encode gzip
# }
#
# # 未来其他游戏子站示例（解析加 A 记录后取消注释即可）：
# # lol.yilangames.com {
# # 	reverse_proxy 127.0.0.1:3001
# # }
